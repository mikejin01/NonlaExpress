# Full-resolution photography harvested from the old Wix site (~162MB).
# Reference only — web renditions live in static/assets/images/.
docs/assets/original-site/photos/

# Client-delivered video masters (e.g. the 39MB 4K hero). Reference only —
# the shipped renditions are transcoded into static/assets/videos/.
docs/assets/video-source/

# Client-delivered photo masters (e.g. the 5.8MB burger AVIFs). Reference only —
# the shipped renditions are cropped/resized into static/assets/images/.
docs/assets/image-source/

# Generated WordPress theme — rebuilt by `pnpm run build:wordpress` every time.
/wordpress-theme
/*.zip

# Theme pulled down from the live server for inspection (`make pull`).
/siteground

# Throwaway WP-CLI exports used by `make pull-content` / `make check-content-drift`.
# The merged result lands in the tracked src/lib/content-overrides.json.
/.content-sync

# Per-site SSH/deploy credentials — must NEVER be committed.
# Only the documented template and README are tracked.
.live-sites/*.mk
!.live-sites/_template.mk

# Shared cross-project reference, symlinked in from another client repo.
# Local convenience only — the link would dangle for anyone else.
docs/SPA-TO-WORDPRESS-THEME-PLAYBOOK.md
